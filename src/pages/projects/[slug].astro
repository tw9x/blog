---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, url } from '../../consts';
import { getSortedProjects } from '../../utils';

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);

const statusLabel: Record<string, string> = {
  active: '维护中',
  wip: '进行中',
  archived: '已归档',
};
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article>
    <header class="mb-10">
      <h1 class="font-serif text-3xl font-semibold tracking-tight">{project.data.title}</h1>
      <p class="mt-3 flex flex-wrap items-center gap-x-3 text-sm text-faint">
        <span class="rounded-full border border-line px-2 py-0.5">
          {statusLabel[project.data.status] ?? project.data.status}
        </span>
        <time datetime={project.data.startDate.toISOString()}>
          {formatDate(project.data.startDate)}
          {project.data.endDate && ` – ${formatDate(project.data.endDate)}`}
        </time>
      </p>

      {
        project.data.stack.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {project.data.stack.map((tech) => (
              <li class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">
                {tech}
              </li>
            ))}
          </ul>
        )
      }

      {
        (project.data.repo || project.data.demo) && (
          <p class="mt-5 flex flex-wrap gap-4 text-sm">
            {project.data.repo && (
              <a
                href={project.data.repo}
                class="text-accent underline underline-offset-3 hover:no-underline"
                rel="noopener noreferrer"
                target="_blank"
              >
                源码
              </a>
            )}
            {project.data.demo && (
              <a
                href={project.data.demo}
                class="text-accent underline underline-offset-3 hover:no-underline"
                rel="noopener noreferrer"
                target="_blank"
              >
                在线演示
              </a>
            )}
          </p>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <p class="mt-14 border-t border-line pt-6">
      <a href={url('/projects/')} class="text-sm text-muted transition-colors hover:text-ink">
        ← 返回项目列表
      </a>
    </p>
  </article>
</BaseLayout>
