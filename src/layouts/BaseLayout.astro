---
import { SITE, NAV, url } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 文章页传入，用于 og:type */
  type?: 'website' | 'article';
  /** 文章发布时间，用于 og:article */
  publishedTime?: Date;
  /** 首页归档视图使用：隐藏站点页脚，让页面只剩时间线 */
  hideFooter?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedTime,
  hideFooter = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.description}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={url('/rss.xml')}
    />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fdfcfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191817" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-surface-2 focus:px-3 focus:py-2 focus:text-sm"
      >跳到正文</a
    >

    <header class="border-b border-line">
      <nav
        class="mx-auto flex max-w-2xl items-center px-6 py-7"
        aria-label="主导航"
      >
        <ul class="flex items-center gap-5 text-sm text-muted">
          {
            NAV.map((item) => {
              // pathname 含 base 前缀（部署在 /blog 下时是 /blog/posts/），
              // 先剥掉前缀再和 NAV 里的路径比较，否则高亮永远不生效
              const base = import.meta.env.BASE_URL.replace(/\/$/, '');
              const path = Astro.url.pathname.slice(base.length) || '/';
              const isActive =
                item.href === '/' ? path === '/' : path.startsWith(item.href);
              return (
                <li>
                  <a
                    href={url(item.href)}
                    aria-current={isActive ? 'page' : undefined}
                    class:list={[
                      'transition-colors hover:text-ink',
                      isActive && 'text-ink font-medium',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </header>

    <main id="main" class="mx-auto w-full max-w-2xl flex-1 px-6 py-14">
      <slot />
    </main>

    {
      !hideFooter && (
        <footer class="border-t border-line">
          <div class="mx-auto flex max-w-2xl flex-wrap items-center justify-between gap-3 px-6 py-8 text-sm text-faint">
            <p>
              © {new Date().getFullYear()} {SITE.author}
            </p>
            <p>
              <a href={url('/rss.xml')} class="transition-colors hover:text-ink">
                RSS
              </a>
            </p>
          </div>
        </footer>
      )
    }
  </body>
</html>
